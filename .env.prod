# ----------------- 基础信息 -----------------
APP_NAME=MemoryPalace
API_PREFIX=/api/v1
DEBUG=False

# ----------------- 安全 -----------------
# 生产环境请把密钥保存在 CI/CD Secret 或 KMS 中，这里仅作示例
API_KEYS=prodkey_a1b2c3d4,prodkey_e5f6g7h8

# ----------------- Qdrant -----------------
QDRANT_HOST=prod-qdrant.example.com   # 生产 Qdrant 地址
QDRANT_PORT=6333
COLLECTION_NAME=memory_palace
TIME_DECAY_LAMBDA=0.0001    # 正式业务的衰减系数

# ----------------- FlagEmbedding -----------------
# 这里使用更大的模型，效果更好（如果显存足够）
BGE_MODEL_NAME=BAAI/bge-large-zh
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
HF_TOKENIZER_MODEL=BAAI/bge-large-zh

# ----------------- ONNX 缓存目录 -----------------
ONNX_CACHE_DIR=/opt/onnx_cache    # 挂载到宿主机持久卷

# ----------------- 日志 -----------------
LOG_LEVEL=INFO

# ----------------- 可选索引开关 -----------------
ENABLE_CATEGORY_INDEX=True
ENABLE_AUTHOR_INDEX=True
